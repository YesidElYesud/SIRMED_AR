  m_Script: {fileID: 11500000, guid: 56c9d9f53c2b8e04b88a323cdbd1e524, type: 3}
  m_Name: Trivia-Sirena
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.TriviaData
  topic: "Se\xF1ales de alerta"
  question: "Si escuchas una alerta del SAT, \xBFqu\xE9 debes hacer primero?"
  options:
  - optionText: "Acercarte a la quebrada para comprobar personalmente qué está ocurriendo."
    isCorrect: 0
    feedbackText: "No. Acercarte al cauce te expone al peligro. Primero atiende la información oficial y actúa según el nivel de alerta."
  - optionText: "Esperar a que otras personas comiencen a evacuar antes de tomar una decisión."
    isCorrect: 0
    feedbackText: "No. Esperar a los demás hace perder tiempo valioso. Atiende la información oficial y actúa según el nivel de alerta."
  - optionText: "Atender la información oficial y actuar según el nivel de alerta."
    isCorrect: 1
    feedbackText: "¡Correcto! Cada nivel de alerta indica qué hacer. Seguir la información oficial te ayuda a actuar a tiempo."
  - optionText: "Ignorar la alerta si todavía no observas una situación peligrosa."
    isCorrect: 0
    feedbackText: "No. Cuando el peligro se ve, puede ser tarde. Atiende la información oficial y actúa según el nivel de alerta."
  answerDelay: 2.5
