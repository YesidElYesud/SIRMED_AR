  m_Script: {fileID: 11500000, guid: 56c9d9f53c2b8e04b88a323cdbd1e524, type: 3}
  m_Name: Trivia-N2-Quebrada
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.TriviaData
  topic: Comportamiento seguro
  question: "Si el nivel de la quebrada aumenta r\xE1pidamente, \xBFqu\xE9 acci\xF3n
    es m\xE1s segura?"
  options:
  - optionText: "Alejarse del cauce y prepararse para seguir la ruta de evacuación."
    isCorrect: 1
    feedbackText: "¡Correcto! Alejarte a tiempo y tener clara la ruta reduce tu exposición al riesgo."
  - optionText: "Acercarse al cauce para observar cuánto ha aumentado el nivel del agua."
    isCorrect: 0
    feedbackText: "No. Una creciente puede cambiar rápidamente. Aléjate del cauce y prepárate para seguir la ruta de evacuación."
  - optionText: "Permanecer en el mismo lugar hasta confirmar visualmente un desbordamiento."
    isCorrect: 0
    feedbackText: "No. Esperar a ver el desbordamiento te deja sin tiempo para reaccionar. Aléjate del cauce y prepárate para seguir la ruta de evacuación."
  - optionText: "Buscar una zona más cercana a la quebrada desde donde sea posible observar mejor."
    isCorrect: 0
    feedbackText: "No. Acercarte al cauce aumenta tu exposición al riesgo. Aléjate y prepárate para seguir la ruta de evacuación."
  answerDelay: 2.5
