  m_Script: {fileID: 11500000, guid: 56c9d9f53c2b8e04b88a323cdbd1e524, type: 3}
  m_Name: Trivia-N2-Quebrada
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.TriviaData
  topic: Comportamiento seguro
  question: "Si el nivel de la quebrada aumenta r\xE1pidamente, \xBFqu\xE9 acci\xF3n
    es m\xE1s segura?"
  options:
  - optionText: "Alejarse del cauce y prepararse para seguir la ruta de evacuaci\xF3n"
    isCorrect: 1
    feedbackText: "\xA1Correcto! Alejarte a tiempo y tener clara la ruta reduce tu
      exposici\xF3n al riesgo."
  - optionText: Acercarse al cauce para tomar fotos o videos
    isCorrect: 0
    feedbackText: "No. Una creciente puede cambiar r\xE1pidamente. Al\xE9jate del
      cauce y prep\xE1rate para seguir la ruta de evacuaci\xF3n."
  - optionText: "Quedarse en casa sin prestar atenci\xF3n a las alertas"
    isCorrect: 0
    feedbackText: "No. Ignorar las alertas te deja sin tiempo para reaccionar. Al\xE9jate
      del cauce y prep\xE1rate para seguir la ruta de evacuaci\xF3n."
  answerDelay: 2.5
