  m_Script: {fileID: 11500000, guid: 56c9d9f53c2b8e04b88a323cdbd1e524, type: 3}
  m_Name: Trivia-Lider
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.TriviaData
  question: "\xBFPor qu\xE9 es importante el liderazgo comunitario en un SAT?"
  options:
  - optionText: "Porque el l\xEDder reemplaza a los organismos de socorro"
    isCorrect: 0
    feedbackText: "No. El l\xEDder no reemplaza a los organismos de socorro: facilita la comunicaci\xF3n, la preparaci\xF3n y una respuesta organizada."
  - optionText: "Porque as\xED los dem\xE1s vecinos no tienen que prepararse"
    isCorrect: 0
    feedbackText: "No. La preparaci\xF3n es de todos. El liderazgo facilita la comunicaci\xF3n, la preparaci\xF3n y una respuesta organizada."
  - optionText: "Porque facilita la comunicaci\xF3n, la preparaci\xF3n y una respuesta organizada"
    isCorrect: 1
    feedbackText: "\xA1Correcto! Una comunidad organizada se comunica mejor y responde a tiempo ante una alerta."
  answerDelay: 2.5
