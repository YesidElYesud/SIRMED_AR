  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 56c9d9f53c2b8e04b88a323cdbd1e524, type: 3}
  m_Name: Trivia-Lider
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.TriviaData
  topic: "Organizaci\xF3n comunitaria"
  question: "\xBFPor qu\xE9 es importante el liderazgo comunitario en un SAT?"
  options:
  - optionText: "Porque reemplaza completamente a los organismos oficiales durante una emergencia."
    isCorrect: 0
    feedbackText: "No. El liderazgo comunitario no reemplaza a los organismos oficiales: facilita la comunicación, la preparación y una respuesta organizada."
  - optionText: "Porque permite que una sola persona decida cuándo debe evacuar toda la comunidad."
    isCorrect: 0
    feedbackText: "No. La evacuación se decide según el nivel de alerta oficial. El liderazgo facilita la comunicación, la preparación y una respuesta organizada."
  - optionText: "Porque su función principal es vigilar permanentemente el nivel de la quebrada"
    isCorrect: 0
    feedbackText: "No. El monitoreo del agua lo hacen los sensores del SAT. El liderazgo facilita la comunicación, la preparación y una respuesta organizada."
  - optionText: "Porque facilita comunicación, preparación y respuesta organizada."
    isCorrect: 1
    feedbackText: "¡Correcto! Una comunidad organizada se comunica mejor y responde a tiempo ante una alerta."
  answerDelay: 2.5
