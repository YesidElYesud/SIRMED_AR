  m_Script: {fileID: 11500000, guid: 56c9d9f53c2b8e04b88a323cdbd1e524, type: 3}
  m_Name: Trivia-Sensor
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.TriviaData
  question: "\xBFPara qu\xE9 sirve el sensor instalado cerca de la quebrada?"
  options:
  - optionText: "Monitorear el nivel y el comportamiento del agua para apoyar el sistema de alerta"
    isCorrect: 1
    feedbackText: "\xA1Correcto! El sensor vigila el agua de forma continua y sus datos ayudan a generar las alertas del SAT."
  - optionText: "Avisar con sonido a los vecinos"
    isCorrect: 0
    feedbackText: "No. El aviso sonoro lo da la sirena. El sensor monitorea el nivel y el comportamiento del agua para apoyar el sistema de alerta."
  - optionText: "Medir la temperatura del barrio"
    isCorrect: 0
    feedbackText: "No. El sensor monitorea el nivel y el comportamiento del agua de la quebrada para apoyar el sistema de alerta."
  answerDelay: 2.5
