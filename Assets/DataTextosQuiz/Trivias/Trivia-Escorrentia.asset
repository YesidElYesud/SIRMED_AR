  m_Script: {fileID: 11500000, guid: 56c9d9f53c2b8e04b88a323cdbd1e524, type: 3}
  m_Name: Trivia-Escorrentia
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.TriviaData
  topic: "Comportamiento seguro en v\xEDas inundadas"
  question: "\xBFQu\xE9 debes hacer si tu ruta cruza por una calle con agua en movimiento?"
  options:
  - optionText: "Cruzar r\xE1pido si el agua parece poco profunda"
    isCorrect: 0
    feedbackText: "No. Aunque parezca poco profunda, el agua en movimiento puede
      arrastrarte. Nunca es seguro caminar a trav\xE9s de una inundaci\xF3n."
  - optionText: Cruzar en carro o en moto
    isCorrect: 0
    feedbackText: "No. Nunca es seguro conducir a trav\xE9s de una inundaci\xF3n:
      el agua puede arrastrar veh\xEDculos. Busca un terreno elevado."
  - optionText: Evitar el contacto con el flujo de agua
    isCorrect: 1
    feedbackText: "\xA1Correcto! Nunca es seguro caminar o conducir a trav\xE9s de
      una inundaci\xF3n. Busca un terreno elevado o un camino alterno."
  answerDelay: 2.5
