  m_Script: {fileID: 11500000, guid: 56c9d9f53c2b8e04b88a323cdbd1e524, type: 3}
  m_Name: Trivia-Ruta
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.TriviaData
  topic: "Evacuaci\xF3n"
  question: "\xBFCu\xE1l es el objetivo de la ruta de evacuaci\xF3n?"
  options:
  - optionText: "Conducir a la comunidad hacia una zona segura/punto de encuentro."
    isCorrect: 1
    feedbackText: "¡Correcto! La ruta está definida para que todos lleguen de forma ordenada a una zona segura."
  - optionText: "Indicar el camino más rápido para acercarse a la quebrada."
    isCorrect: 0
    feedbackText: "No. La ruta te aleja del cauce: conduce a la comunidad hacia una zona segura o punto de encuentro."
  - optionText: "Señalar únicamente dónde se encuentran instalados los sensores del SAT."
    isCorrect: 0
    feedbackText: "No. La ruta no marca los sensores: conduce a la comunidad hacia una zona segura o punto de encuentro."
  - optionText: "Permitir que cada persona elija cualquier camino para salir del sector."
    isCorrect: 0
    feedbackText: "No. La ruta está definida para evitar zonas de riesgo: seguirla lleva a todos de forma ordenada a la zona segura."
  answerDelay: 2.5
