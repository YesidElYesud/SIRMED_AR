  m_Script: {fileID: 11500000, guid: 56c9d9f53c2b8e04b88a323cdbd1e524, type: 3}
  m_Name: Trivia-Ruta
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.TriviaData
  topic: "Evacuaci\xF3n"
  question: "\xBFCu\xE1l es el objetivo de la ruta de evacuaci\xF3n?"
  options:
  - optionText: "Llegar m\xE1s r\xE1pido a la quebrada"
    isCorrect: 0
    feedbackText: 'No. La ruta te aleja del cauce: conduce a la comunidad hacia una
      zona segura o punto de encuentro.'
  - optionText: Conducir a la comunidad hacia una zona segura o punto de encuentro
    isCorrect: 1
    feedbackText: "\xA1Correcto! La ruta est\xE1 definida para que todos lleguen
      de forma ordenada a una zona segura."
  - optionText: "Recorrer el barrio para ver qu\xE9 est\xE1 pasando"
    isCorrect: 0
    feedbackText: "No. En una evacuaci\xF3n no se recorre el barrio: la ruta conduce
      a la comunidad hacia una zona segura o punto de encuentro."
  answerDelay: 2.5
