  npcName: Lider Comunitario
  npcPhoto: {fileID: 21300000, guid: 182acf71ddf9c950fa17aa1f5eb640e3, type: 3}
  dialogueEntries:
  - text: "Hola, vecino. En este momento estamos en alerta amarilla, as\xED que es
      importante estar atentos."
    audio: {fileID: 8300000, guid: c5d7d3a990b5aec8ba6861388485549e, type: 3}
  - text: "Te recomiendo consultar el Geoportal del SIATA para ver c\xF3mo est\xE1
      el nivel de la quebrada y revisar el SIRMED. "
    audio: {fileID: 8300000, guid: 1af03e897ad3f064398cb1170695f52b, type: 3}
  - text: Mantente informado y preparado ante cualquier cambio en las condiciones.
    audio: {fileID: 8300000, guid: d86d14237673c9d079d3862a3e4e4bae, type: 3}
  dialogueLines:
  - "Hola, vecino. En este momento estamos en alerta amarilla, as\xED que es importante
    estar atentos."
  - "Te recomiendo consultar el Geoportal del SIATA para ver c\xF3mo est\xE1 el nivel
    de la quebrada y revisar el SIRMED. Mantente informado y preparado ante cualquier
    cambio en las condiciones."
  npcText: "\xBFQu\xE9 haces ante una alerta de inundaci\xF3n?"
  options: []
  advancesStageOnCorrect: 0
