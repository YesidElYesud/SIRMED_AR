  m_Name: Ayuda Carlos 2
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.NpcDialogueData
  npcName: Carlos
  npcPhoto: {fileID: 0}
  dialogueEntries:
  - text: "Pero si me quedo en la orilla no me pasa nada..."
    audio: {fileID: 8300000, guid: 74937c648b9e450b91a9c4f324ee52ca, type: 3}
  - text: "\xBFQu\xE9 le respondes?"
    audio: {fileID: 0}
  dialogueLines: []
  npcText: 
  options:
  - optionText: "La orilla es lo primero que se lleva el agua. Venga, subamos a un terreno m\xE1s alto."
    isCorrect: 1
    feedbackText: "\xA1Bien! La distancia segura no es negociable: el riesgo cambia en segundos."
  - optionText: "Bueno, un ratico y nos vamos."
    isCorrect: 0
    feedbackText: "No. En la orilla el riesgo cambia en segundos; no hay \"un ratico\" seguro junto al cauce."
