  m_Name: Ayuda Nino Separado
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.Gameplay.Dialogue.NpcDialogueData
  npcName: "Ni\xF1o"
  npcPhoto: {fileID: 0}
  dialogueEntries:
  - text: "No encuentro a mi mam\xE1... est\xE1bamos juntos y ahora no s\xE9 d\xF3nde est\xE1."
    audio: {fileID: 0}
  - text: "\xBFQu\xE9 haces?"
    audio: {fileID: 0}
  dialogueLines: []
  npcText: 
  options:
  - optionText: "Lo llevo a su casa a buscar a su mam\xE1"
    isCorrect: 0
    feedbackText: "No. Regresar a la zona de riesgo los pone en peligro a los dos. Mantenlo en una zona segura y avisa al l\xEDder."
  - optionText: "Le digo que la busque solo por el barrio"
    isCorrect: 0
    feedbackText: "No. Un ni\xF1o solo es muy vulnerable. Qu\xE9date con \xE9l en una zona segura y avisa al l\xEDder o a las autoridades."
  - optionText: "Lo mantengo en una zona segura y aviso al l\xEDder comunitario o a las autoridades"
    isCorrect: 1
    feedbackText: "\xA1Muy bien! Protegerlo en un lugar seguro y pedir ayuda al l\xEDder o a los organismos de socorro es lo correcto."
  advancesStageOnCorrect: 0
