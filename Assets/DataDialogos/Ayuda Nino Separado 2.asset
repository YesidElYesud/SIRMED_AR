  npcName: "Samuel"
  npcPhoto: {fileID: 0}
  dialogueEntries:
  - text: "\xBFY si no la encuentran?"
    audio: {fileID: 8300000, guid: 9b05b3d2af6941f4916b9ee8087e14e3, type: 3}
  - text: "\xBFQu\xE9 le respondes?"
    audio: {fileID: 0}
  dialogueLines: []
  npcText: 
  options:
  - optionText: "La van a buscar las personas que saben. T\xFA ayudas m\xE1s si te quedas tranquilo aqu\xED conmigo."
    isCorrect: 1
    feedbackText: "\xA1Bien! Transmitir calma y seguridad lo ayuda a no angustiarse."
  - optionText: "Puede ser\u2026 toca esperar a ver qu\xE9 pasa."
    isCorrect: 0
    feedbackText: "No. Esa respuesta aumenta su angustia. Transm\xEDtele calma y seguridad."
