  m_Script: {fileID: 11500000, guid: af0c689234df4684385c8845fbcba2c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SIRMED.UI.WelcomePanel
  _slideSet: {fileID: 0}
  slideData:
  - title: Controles
    body: "Esta experiencia usa Realidad Aumentada real:\n\n\xB7 Camina f\xEDsicamente
      por el sector para moverte \u2014 no hay joystick.\n\xB7 Apunta la c\xE1mara
      del tel\xE9fono al entorno para mirar alrededor.\n\xB7 Toca el bot\xF3n que
      aparece en pantalla cuando est\xE9s cerca de un punto de inter\xE9s.\n\n\U0001F4F1
      Antes de presionar COMENZAR:\nSost\xE9n el tel\xE9fono frente a ti, en posici\xF3n
      vertical, apuntando hacia el entorno."
    image: {fileID: 0}
  - title: "\xBFQu\xE9 es el SATC?"
    body: "El Sistema de Alerta Temprana Comunitaria (SATC) te permite conocer el
      nivel de riesgo de tu barrio ante crecientes s\xFAbitas de la quebrada.\n\nEn
      esta experiencia aprender\xE1s a reconocer las se\xF1ales de alerta, a comunicarte
      con el SIATA y a actuar como l\xEDder comunitario ante una emergencia hidrol\xF3gica."
    image: {fileID: 0}
  slideTemplate: {fileID: 0}
  slideTitle: {fileID: 0}
  slideBody: {fileID: 0}
  slideImage: {fileID: 0}
  slides:
  - {fileID: 1028498771}
